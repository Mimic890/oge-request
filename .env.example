# Telegram Bot API token (получить у @BotFather)
TG_TOKEN=

# Telegram ID администратора (узнать у @userinfobot)
ADMIN_ID=

# Часовой пояс (по умолчанию UTC)
TZ=Europe/Moscow

# Максимум пользователей (0 = без лимита)
MAX_USERS=0

# Максимум запросов к сайту в секунду (по умолчанию 2)
MAX_RPS=2

# Параллельность фоновой проверки (по умолчанию 5)
CHECK_CONCURRENCY=5

# Домен сайта с результатами (по умолчанию ege-kostroma.ru)
SITE_DOMAIN=ege-kostroma.ru

# Прокси (необязательно, раскомментировать при необходимости)
# HTTP_PROXY=http://user:pass@proxy-host:port
# HTTPS_PROXY=http://user:pass@proxy-host:port
# NO_PROXY=localhost,127.0.0.1
